# YouTube OAuth for the Gudasol channel only.
# Copy to Gudasol/.env (gitignored) and fill in.

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_ACCESS_TOKEN=

# Optional posting chrome for this project
YOUTUBE_TITLE_PREFIX=Gudasol AI |
YOUTUBE_TAGS=Gudasol AI,EASY
# YOUTUBE_DISCLAIMER=
